# k8s_validate_v2.py

from kubernetes import client, config
from kubernetes.client.rest import ApiException

# Load kubeconfig
config.load_kube_config()

# Configuration
NAMESPACE = "default"
DEPLOYMENT_NAME = "nginx-deployment"
EXPECTED_IMAGE = "nginx:latest"

apps_v1 = client.AppsV1Api()
core_v1 = client.CoreV1Api()

def validate_deployment():

    try:
        deployment = apps_v1.read_namespaced_deployment(
            name=DEPLOYMENT_NAME,
            namespace=NAMESPACE
        )

        print("\n========== DEPLOYMENT DETAILS ==========")
        print(f"Deployment : {DEPLOYMENT_NAME}")
        print(f"Namespace  : {NAMESPACE}")

        # Replica validation
        desired = deployment.spec.replicas
        available = deployment.status.available_replicas or 0
        ready = deployment.status.ready_replicas or 0

        print(f"Desired Replicas : {desired}")
        print(f"Available Pods   : {available}")
        print(f"Ready Pods       : {ready}")

        if desired == available:
            print("Replica Validation : SUCCESS")
        else:
            print("Replica Validation : FAILED")

        # Image validation
        containers = deployment.spec.template.spec.containers

        for container in containers:
            print(f"\nContainer Name : {container.name}")
            print(f"Container Image: {container.image}")

            if container.image == EXPECTED_IMAGE:
                print("Image Validation : SUCCESS")
            else:
                print("Image Validation : FAILED")

        # Pod validation
        label_selector = ""

        labels = deployment.spec.selector.match_labels

        for key, value in labels.items():
            label_selector += f"{key}={value},"

        label_selector = label_selector.rstrip(",")

        pods = core_v1.list_namespaced_pod(
            namespace=NAMESPACE,
            label_selector=label_selector
        )

        print("\n========== POD STATUS ==========")

        for pod in pods.items:
            pod_name = pod.metadata.name
            phase = pod.status.phase

            print(f"Pod Name : {pod_name}")
            print(f"Status   : {phase}")

            if phase == "Running":
                print("Pod Health : HEALTHY")
            else:
                print("Pod Health : UNHEALTHY")

            print("--------------------------------")

        # Rollout validation
        conditions = deployment.status.conditions

        print("\n========== ROLLOUT STATUS ==========")

        if conditions:
            for condition in conditions:
                print(f"Type   : {condition.type}")
                print(f"Status : {condition.status}")
                print(f"Reason : {condition.reason}")

        print("\nDeployment Validation Completed Successfully")

    except ApiException as e:
        print(f"Kubernetes API Error: {e}")

    except Exception as ex:
        print(f"General Error: {ex}")

if __name__ == "__main__":
    validate_deployment()
