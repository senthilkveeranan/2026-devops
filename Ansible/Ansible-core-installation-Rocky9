#!/bin/bash

# Ansible Core Installation Script for Rocky Linux 9

set -e

echo "======================================="
echo " Ansible Core Installation Started"
echo "======================================="

# Refresh repository cache
dnf makecache

# Install EPEL Repository
dnf install -y epel-release

# Install Ansible Core
dnf install -y ansible-core

# Verify Installation
ansible --version

# Create Ansible Working Directory
mkdir -p /opt/ansible/{inventory,playbooks,roles}

# Configure Hosts File
cat <<EOF > /etc/ansible/hosts
[local]
localhost ansible_connection=local
EOF

# Generate SSH Key for Passwordless Authentication
if [ ! -f /home/vagrant/.ssh/id_rsa ]; then
    sudo -u vagrant ssh-keygen -t rsa -N "" -f /home/vagrant/.ssh/id_rsa
fi

# Set Permissions
chown -R vagrant:vagrant /home/vagrant/.ssh
chmod 700 /home/vagrant/.ssh
chmod 600 /home/vagrant/.ssh/id_rsa

echo "======================================="
echo " Ansible Core Installation Completed"
echo "======================================="
