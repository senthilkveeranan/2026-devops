Vagrant.configure("2") do |config|

config.vm.box = "generic/rhel9"
config.vm.synced_folder ".", "/vagrant", disabled: true

nodes = [
{
:name => "aap",
:hostname => "ansible-aap.example.com",
:ip => "192.168.56.90",
:memory => 20480,
:cpu => 2
},
{
:name => "managed1",
:hostname => "managed1.example.com",
:ip => "192.168.56.91",
:memory => 3048,
:cpu => 2
},
{
:name => "kubemaster",
:hostname => "kubemaster.example.com",
:ip => "192.168.56.92",
:memory => 4096,
:cpu => 2
}
]

nodes.each do |node|
config.vm.define node[:name] do |machine|

  machine.vm.hostname = node[:hostname]
  machine.vm.network "private_network", ip: node[:ip]

  machine.vm.provider "virtualbox" do |vb|
    vb.name = node[:hostname]
    vb.memory = node[:memory]
    vb.cpus = node[:cpu]
  end

  machine.vm.provision "shell", inline: <<-SHELL

    hostnamectl set-hostname #{node[:hostname]}

    cat <<EOF >/etc/hosts

127.0.0.1 localhost
192.168.56.90 ansible-aap.example.com aap-rhel9
192.168.56.91 managed1.example.com managed1
192.168.56.92 kubemaster.example.com kubemaster
EOF

    dnf clean all

    dnf install -y \
    vim wget curl git unzip tar net-tools bind-utils \
    python3 python3-pip sshpass rsync podman

    systemctl enable --now sshd

  SHELL

  if node[:name] == "aap"

    machine.vm.provision "shell", inline: <<-SHELL

      dnf install -y ansible-core

      mkdir -p /root/aap

      ssh-keygen -t rsa -N "" -f /root/.ssh/id_rsa

      echo "AAP Controller Ready"

      ansible --version

    SHELL

  end

  if node[:name] == "managed1"

    machine.vm.provision "shell", inline: <<-SHELL

      useradd ansible 2>/dev/null || true

      echo "ansible:Redhat123" | chpasswd

      echo "Managed Node Ready"

    SHELL

  end

  if node[:name] == "kubemaster"

    machine.vm.provision "shell", inline: <<-SHELL

      swapoff -a

      sed -i '/swap/d' /etc/fstab

      cat <<EOF | tee /etc/modules-load.d/k8s.conf

overlay
br_netfilter
EOF

      modprobe overlay
      modprobe br_netfilter

      cat <<EOF | tee /etc/sysctl.d/k8s.conf

net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward = 1
EOF

      sysctl --system

      dnf install -y containerd

      systemctl enable --now containerd

      echo "Kubernetes Master Prerequisites Ready"

    SHELL

  end

end

end

end
